[input_devices]

pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translations_pot_files=PackedStringArray("res://assets/dialogue/intro.dialogue", "res://assets/dialogue/powerjump.dialogue", "res://assets/dialogue/time_to_go_up.dialogue", "res://assets/dialogue/contemplation.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

